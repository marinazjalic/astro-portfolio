---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PageShapes from '../components/PageShapes.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About — Marina Zjalic">
  <div class="page-root grid-bg min-h-screen">

    <PageShapes />
    <Navbar />

    <!-- ── Hero bar ───────────────────────────── -->
    <header class="about-hero">
      <div class="flex items-center gap-3 mb-4">
        <div class="bg-[#3C8FA8] w-12 h-[1.5px]"></div>
        <p class="section-label">Hello</p>
      </div>
      <h1 class="about-heading">About Me</h1>
      <p class="about-sub">Software developer · Ontario, Canada </p>
    </header>

    <!-- ── Main content ───────────────────────── -->
    <main class="about-main">

      <!-- Left column: profile + sidebar cards -->
      <aside class="sidebar-col">

        <!-- Profile picture -->
        <div class="side-card profile-card reveal">
          <div class="profile-photo">
            <span class="profile-initials" aria-hidden="true">MZ</span>
            <img
              src="/profile.png"
              alt="Marina Zjalic"
              class="profile-img"
              onerror="this.style.display='none'"
            />
          </div>
        </div>

        <!-- Currently -->
        <div class="side-card reveal delay-100">
          <p class="section-label mb-4">Currently</p>
          <ul class="side-list">
            <li class="side-item">
              <span class="side-arrow">▸</span>
              <span>Software Engineer at <strong>Level One Robotics, Inc</strong></span>
            </li>
            <li class="side-item">
              <span class="side-arrow">▸</span>
              <span>Based in Ontario, Canada </span>
            </li>
            <!-- <li class="side-item">
              <span class="side-arrow">▸</span>
              <span>Open to interesting opportunities</span>
            </li> -->
          </ul>
        </div>

        <!-- Education -->
        <div class="side-card reveal delay-200">
          <p class="section-label mb-4">Education</p>
          <p class="edu-degree">B.S Honours Computer Science</p>
          <p class="edu-school">University of Windsor</p>
          <p class="edu-year">Graduated 2024</p>
        </div>
      </aside>

      <!-- Right column: bio + CTA -->
      <div class="bio-col reveal">

        <div class="bio-card">
          <p class="bio-text">
            I'm a software developer with 2+ years of professional experience building backend services,
            full-stack applications, and systems integrations. I work mostly with C#, JavaScript, and Python,
            using technologies like .NET, React, and Node.js
          </p>

          <p class="bio-text">
            I really enjoy figuring out how things work, and I've had experience building tools across a wide
            range of problems. I've built web and mobile apps, REST APIs, and machine learning pipelines.
            In my recent role, I learned how to work with robotics systems, which has strengthened my
            engineering skills and has made me more delibrate about writing reliable code for real-world 
            problems.
          </p>

          <p class="bio-text">
            In my free time, I like to read, cook, and spend time outdoors. I also build fun side projects
            every now and then.
          </p>
          </p>
        </div>

        <!-- CTA -->
        <div class="cta-row reveal delay-200">
          <a
            href="https://linkedin.com/in/marinazjalic"
            target="_blank"
            rel="noopener noreferrer"
            class="cta-btn-fill"
          >
            Connect on LinkedIn →
          </a>
          <a href="/portfolio" class="cta-btn-outline">
            View my work →
          </a>
        </div>
      </div>
    </main>
    <Footer/>

  </div>
</Layout>

<style>
  /* ── Page root needs relative for PageShapes ── */
  .page-root { position: relative; }

  /* ── Shared padding — matches index.astro ── */
  .about-hero,
  .about-main,
  .about-footer {
    width: 100%;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
  @media (min-width: 768px) {
    .about-hero, .about-main, .about-footer {
      padding-left: 3rem;
      padding-right: 3rem;
    }
  }
  @media (min-width: 1024px) {
    .about-hero, .about-main, .about-footer {
      padding-left: 5rem;
      padding-right: 5rem;
    }
  }

  /* ── Hero bar ── */
  .about-hero {
    padding-top: 3.5rem;
    padding-bottom: 2rem;
  }
  .about-heading {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: #6b7280;
    margin: 0 0 6px;
    line-height: 1.1;
  }
  .about-sub {
    font-size: 0.875rem;
    color: #9ca3af;
    font-family: monospace;
    margin: 0;
  }

  /* ── Main two-col layout ── */
  .about-main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 1rem;
    padding-bottom: 4rem;
  }
  @media (min-width: 1024px) {
    .about-main {
      flex-direction: row;
      align-items: flex-start;
      gap: 3rem;
    }
  }

  /* ── Bio column ── */
  .bio-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
  }

  .bio-card {
    background: rgba(255, 255, 255, 0.55);
    border: 0.5px solid #d6d2c4;
    border-radius: 10px;
    padding: 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    overflow: hidden;
  }
  /* Teal left accent */
  .bio-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: linear-gradient(to bottom, #3C8FA8, #C17B9E);
    border-radius: 10px 0 0 10px;
  }

  .bio-text {
    font-size: 0.9rem;
    color: #6b7280;
    line-height: 1.75;
    margin: 0;
  }
  .teal  { color: #3C8FA8; font-weight: 500; }
  .pink  { color: #C17B9E; font-weight: 500; }

  /* ── Stat row ── */
  .stat-row {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.55);
    border: 0.5px solid #d6d2c4;
    border-radius: 10px;
    padding: 1.25rem 1.75rem;
    gap: 0;
  }
  .stat-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .stat-num {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #3C8FA8;
    line-height: 1;
  }
  .stat-label-sm {
    font-size: 0.7rem;
    font-family: monospace;
    color: #9ca3af;
    text-align: center;
    letter-spacing: 0.04em;
  }
  .stat-divider {
    width: 0.5px;
    height: 2.5rem;
    background: #d6d2c4;
  }

  /* ── CTA row ── */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cta-btn-fill {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    background: #3C8FA8;
    color: white;
    font-family: monospace;
    font-size: 0.8rem;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .cta-btn-fill:hover { background: #2d7a91; }
  .cta-btn-outline {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border: 1px solid #3C8FA8;
    color: #3C8FA8;
    font-family: monospace;
    font-size: 0.8rem;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .cta-btn-outline:hover { background: rgba(60,143,168,0.08); }

  /* ── Sidebar ── */
  .sidebar-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }
  @media (min-width: 1024px) {
    .sidebar-col { width: 300px; flex-shrink: 0; }
  }

  .side-card {
    background: rgba(255, 255, 255, 0.55);
    border: 0.5px solid #d6d2c4;
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .side-card:hover {
    box-shadow: 0 4px 20px rgba(60, 143, 168, 0.08);
    transform: translateY(-2px);
  }

  /* Profile picture */
  .profile-card { padding: 0.75rem; }
  .profile-photo {
    position: relative;
    aspect-ratio: 1;
    border-radius: 6px;
    overflow: hidden;
    background: rgba(60, 143, 168, 0.1);
    border: 0.5px solid rgba(60, 143, 168, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .profile-initials {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 3rem;
    font-weight: 700;
    color: #3C8FA8;
  }
  .profile-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .side-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .side-item {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    color: #6b7280;
    line-height: 1.5;
  }
  .side-arrow { color: #3C8FA8; flex-shrink: 0; font-size: 0.7rem; margin-top: 3px; }

  /* Education */
  .edu-degree {
    font-size: 0.9rem;
    font-weight: 600;
    color: #4a5f72;
    margin: 0 0 2px;
  }
  .edu-school {
    font-family: monospace;
    font-size: 0.8rem;
    color: #3C8FA8;
    margin: 0 0 2px;
  }
  .edu-year {
    font-size: 0.75rem;
    color: #9ca3af;
    font-family: monospace;
    margin: 0;
  }

  /* Interest tags */
  .tag-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .interest-tag {
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 500;
    background: rgba(60, 143, 168, 0.1);
    color: #2d7a91;
    border: 0.5px solid rgba(60, 143, 168, 0.25);
    padding: 3px 9px;
    border-radius: 4px;
  }

  /* ── Footer ── */
  .about-footer {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    padding-top: 2rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid #e5e7eb;
    font-family: monospace;
    font-size: 0.75rem;
    color: #9ca3af;
  }
  @media (min-width: 768px) {
    .about-footer { flex-direction: row; justify-content: space-between; }
  }
  .footer-right { color: #3C8FA8; }
</style>

<script is:inline>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add("visible");
      });
    },
    { threshold: 0.08 }
  );
  document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
</script>