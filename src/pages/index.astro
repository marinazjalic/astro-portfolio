---
import Layout from '../layouts/Layout.astro';
import Experience from '../components/Experience.astro'
import Navbar from '../components/Navbar.astro'
import Technologies from '../components/Technologies.astro'
import { experiences } from '../data/experiences'


const lastModified = new Date().toLocaleString("en-US").replace(",", '');

---

<Layout>
   <div class="grid-bg min-h-screen">

     <div
      class="absolute -right-30 top-[90%] -translate-y-1/2 -rotate-90
         text-xs tracking-widest text-gray-400 z-50"
      >
      LAST MODIFIED: {lastModified}
    </div>

    <Navbar/>

    <div class="flex flex-col lg:flex-row lg:min-h-screen items-center ml-10 pt-4 md:pt-0">
      <div> 
        <div class="flex flex-row">
          <div class="bg-[#3C8FA8] w-[80px] h-[2px] mb-4 ml-2 mt-1.5"></div>
          <p class="font-mono text-xs ml-4 text-gray-800">Software Developer</p>
        </div>
        
         <h1 class="font-bold tracking-tighter leading-[0.85">
        <span class="block text-[#5b7692] text-8xl lg:text-[9rem]">Marina</span>
        <span class="block bg-gradient-to-r from-[#3C8FA8] via-[#C17B9E] to-[#3C8FA8] bg-clip-text text-transparent pb-10 text-9xl lg:text-[11rem]">
          Zjalic.
        </span>
      </h1>


      <!-- Temporary text -->
      <div class="flex flex-row gap-2 name-text">
        <p class="name-text md:text-xl lg:text-2xl text-gray-600">
          <span class="mr-1 text-xs md:text-sm lg:text-base text-[#3C8FA8]">&lt;dev&gt;</span>
          Building 
          <span class="text-[#D946A6]">delightful</span> 
          digital experiences with 
          <span class="text-[#3C8FA8] italic">creativity</span> 
          & 
          <span class="text-[#D946A6]">code.</span>
          <span class="text-xs md:text-sm lg:text-base text-[#3C8FA8]">&lt;/dev&gt;</span>
        </p> 
      </div>
      
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4">
      <Technologies />

      <p class="text-4xl font-bold default-text text-center mb-6 text-gray-500 mt-30">
        Professional Experience
      </p>

      <div class="relative max-w-6xl mx-auto px-4 py-10">
        <div class="absolute left-[calc(theme(spacing.4))] top-0 h-full w-px bg-[#3C8FA8]"></div>

        <div class="space-y-12 pl-4">
          {experiences.map(exp => (
            <Experience {...exp} />
          ))}
        </div>
    </div>
</div>
</Layout>
