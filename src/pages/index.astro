---
import Layout from '../layouts/Layout.astro';
import Experience from '../components/Experience.astro'
import { experiences } from '../data/experiences'
---

<Layout>
  <div class="bg-[#EBEAE8] min-h-screen">
    <!-- Navbar  -->
   <nav class="flex items-center justify-between text-gray-500 font-mono gap-4 pt-5 px-5 text-sm">
      <a href="/">Home.</a>
      <div class="flex gap-4">
        <a href="/">About.</a>
        <a href="/">Portfolio.</a>
      </div>
    </nav>

    <div class="flex flex-col lg:flex-row lg:min-h-screen items-center ml-10 pt-4 md:pt-0">
      <h1 class="font-bold tracking-tighter mb-6 leading-[0.85]">
        <span class="block text-[#5b7692] text-8xl lg:text-[9rem]">Marina</span>
        <span class="block bg-gradient-to-r from-[#D946A6] via-[#B794F6] to-[#D946A6] bg-clip-text text-transparent pb-10 text-9xl lg:text-[11rem]">
          Zjalic.
        </span>
      </h1>
    </div>
  

    <p class="text-2xl default-text text-center mb-6 text-gray-500">
      Work Experience
    </p>


    {experiences.map(exp => <Experience {...exp} />)} 
  </div>
</Layout>
