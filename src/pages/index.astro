---
import Layout from '../layouts/Layout.astro';
import Experience from '../components/Experience.astro'
import Navbar from '../components/Navbar.astro'
import { experiences } from '../data/experiences'
---

<Layout>
  <div class="bg-[#EBEAE8] min-h-screen">

    <Navbar/>

    <div class="flex flex-col lg:flex-row lg:min-h-screen items-center ml-10 pt-4 md:pt-0">
      <div> 
        <div class="flex flex-row">
          <div class="bg-[#D946A6] w-[80px] h-[2px] mb-4 ml-2 mt-1.5"></div>
          <p class="font-mono text-xs ml-4 text-gray-800">Software Developer</p>
        </div>
        
         <h1 class="font-bold tracking-tighter leading-[0.85">
        <span class="block text-[#5b7692] text-8xl lg:text-[9rem]">Marina</span>
        <span class="block bg-gradient-to-r from-[#D946A6] via-[#B794F6] to-[#D946A6] bg-clip-text text-transparent pb-10 text-9xl lg:text-[11rem]">
          Zjalic.
        </span>
      </h1>


      <!-- Temporary text -->
      <div class="flex flex-row gap-2 name-text">
        <p class="mt-1.5 text-[#8080ff]">&lt;dev&gt;</p>
        <p class="name-text text-2xl text-gray-600">Building <span class="text-[#D946A6]">delightful</span> digital experiences with <span class="text-[#8080ff] italic">creativity</span> & <span class="text-[#D946A6]">code.</span></p> 
        <p class="mt-1.5 text-[#8080ff]">&lt;/dev&gt;</p>
      </div>
      
      </div>
    </div>
  

    <p class="text-2xl default-text text-center mb-6 text-gray-500 mt-30 md:mt-0">
      Work Experience
    </p>


    {experiences.map(exp => <Experience {...exp} />)} 
  </div>
</Layout>
