---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PageShapes from '../components/PageShapes.astro';
import { projects } from '../data/projects';
import Footer from '../components/Footer.astro';
---

<Layout title="Portfolio — Marina Zjalic">
  <div class="page-root grid-bg min-h-screen">

    <PageShapes />
    <Navbar />

    <!-- ── Hero bar ── -->
    <header class="port-hero">
      <div class="flex items-center gap-3 mb-4">
        <div class="bg-[#3C8FA8] w-12 h-[1.5px]"></div>
        <p class="section-label">Work</p>
      </div>
      <h1 class="port-heading">Portfolio</h1>
      <!-- <p class="port-sub">
        A selection of fun things I've built.
      </p> -->
    </header>

    <!-- ── Project list ── -->
    <main class="port-main">
      <div class="proj-list">
        {projects.map(project => (
          <ProjectCard {...project} />
        ))}
      </div>

      <!-- ── Empty state CTA ── -->
      <div class="more-card reveal">
        <p class="more-label">More on the way</p>
        <p class="more-text">
          I'm always building something new. Check my GitHub for the latest work in progress.
        </p>
        <a
          href="https://github.com/marinazjalic"
          target="_blank"
          rel="noopener noreferrer"
          class="more-btn"
        >
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          View GitHub →
        </a>
      </div>
    </main>

    <!-- ── Footer ── -->
    <!-- <footer class="port-footer">
      <p>© {new Date().getFullYear()} Marina Zjalic</p>
      <p class="footer-right">Built with Astro + Tailwind CSS</p>
    </footer> -->
    <Footer/>

  </div>
</Layout>

<style>
  .page-root { position: relative; }

  /* ── Shared padding — identical to about + index ── */
  .port-hero,
  .port-main,
  .port-footer {
    width: 100%;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
  @media (min-width: 768px) {
    .port-hero, .port-main, .port-footer {
      padding-left: 3rem;
      padding-right: 3rem;
    }
  }
  @media (min-width: 1024px) {
    .port-hero, .port-main, .port-footer {
      padding-left: 5rem;
      padding-right: 5rem;
    }
  }

  /* ── Hero bar ── */
  .port-hero {
    padding-top: 3.5rem;
    padding-bottom: 2rem;
  }
  .port-heading {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: #6b7280;
    margin: 0 0 8px;
    line-height: 1.1;
  }
  .port-sub {
    font-size: 0.875rem;
    color: #9ca3af;
    margin: 0;
    max-width: 480px;
  }

  /* ── Project list ── */
  .port-main {
    padding-top: 1rem;
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .proj-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* ── "More on the way" card ── */
  .more-card {
    width: 100%;
    background: rgba(255, 255, 255, 0.45);
    border: 0.5px dashed #c8d0d8;
    border-radius: 10px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }

  .more-label {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1rem;
    font-weight: 700;
    color: #6b7280;
    margin: 0;
  }

  .more-text {
    font-size: 0.82rem;
    color: #9ca3af;
    margin: 0;
    max-width: 360px;
    line-height: 1.6;
  }

  .more-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: monospace;
    font-size: 0.78rem;
    color: #3C8FA8;
    border: 0.5px solid #3C8FA8;
    padding: 6px 16px;
    border-radius: 3px;
    text-decoration: none;
    margin-top: 4px;
    transition: background 0.2s, color 0.2s;
  }
  .more-btn:hover { background: #3C8FA8; color: white; }

  /* ── Footer ── */
  .port-footer {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    padding-top: 2rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid #e5e7eb;
    font-family: monospace;
    font-size: 0.75rem;
    color: #9ca3af;
  }
  @media (min-width: 768px) {
    .port-footer { flex-direction: row; justify-content: space-between; }
  }
  .footer-right { color: #3C8FA8; }
</style>

<script is:inline>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add("visible");
      });
    },
    { threshold: 0.08 }
  );
  document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
</script>