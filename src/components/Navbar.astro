---
import Github from "../assets/github.svg"
import LinkedinIcon from "../assets/linkedin.svg"
---

<nav
  id="navbar"
  class="flex justify-between text-gray-500 font-mono gap-4 pt-5 px-5 text-[13px] top-0 z-50 pb-2 sticky"
>
  <div class="flex flex-row gap-4">
    <a
      href="https://github.com/marinazjalic"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
    >
      <Github class="w-7 h-7 text-[#3C8FA8]" />
    </a>
    <a
      href="https://linkedin.com/in/marinazjalic"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
    >
      <LinkedinIcon class="w-7 h-7 text-[#3C8FA8]" />
    </a>
  </div>

  <div class="flex gap-4 items-center">
    <div class="pt-1 space-x-4">
      <a href="/">01. About</a>
      <a href="/">02. Portfolio</a>
      <a href="/">03. Home</a>
    </div>

    <button class="border-1 p-1 border-[#3C8FA8] text-[#3C8FA8] rounded-sm">
      Resume
    </button>
  </div>
</nav>

<script is:inline>
  const navbar = document.getElementById("navbar");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 20) {
      navbar.classList.add("backdrop-blur-md", "border-b", "border-gray-300");
    } else {
      navbar.classList.remove(
        "backdrop-blur-md",
        "border-b",
        "border-gray-300"
      );
    }
  });
</script>
