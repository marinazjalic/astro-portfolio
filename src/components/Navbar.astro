<nav
  id="navbar"
  class="flex items-center justify-between text-gray-500 font-mono gap-4 pt-5 px-5 text-sm sticky top-0 z-50 pb-2"
>
  <a class="pt-1" href="/">Home.</a>
  <div class="flex gap-4">
    <div class="pt-1">
      <a href="/">About.</a>
      <a href="/">Portfolio.</a>
    </div>

    <button class="border-1 p-1 border-[#D946A6] text-[#D946A6] rounded-sm">
      Resume
    </button>
  </div>
</nav>

<script is:inline>
  const navbar = document.getElementById("navbar");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 20) {
      navbar.classList.add("backdrop-blur-md", "border-b", "border-gray-300");
    } else {
      navbar.classList.remove(
        "backdrop-blur-md",
        "border-b",
        "border-gray-300"
      );
    }
  });
</script>
