---
interface Props {
  title: string;
  description: string;
  points: string[];
  tags: string[];
  githubUrl?: string;
  liveUrl?: string;
  imagePlaceholder?: string;
}

const {
  title,
  description,
  points,
  tags,
  githubUrl,
  liveUrl,
  imagePlaceholder = "#d4e9ef",
} = Astro.props;

const swatchStyle = `background-color: ${imagePlaceholder}`;
---

<div class="w-full max-w-4xl mx-auto px-4 reveal">
  <div
    class="relative w-full flex flex-col md:flex-row rounded-xl border border-[#d6d2c4] shadow-sm bg-white/50 overflow-hidden transition-all duration-300 hover:shadow-md hover:-translate-y-1"
  >
    <!-- Image / color swatch -->
    <div
      class="w-full md:w-[38%] h-48 md:h-auto flex-shrink-0 flex items-center justify-center"
      style={swatchStyle}
    >
      <span class="font-mono text-white/60 text-xs tracking-widest uppercase">{title}</span>
    </div>

    <!-- Content -->
    <div class="flex-1 p-6 flex flex-col text-gray-500 default-text">
      <!-- Accent dot -->
      <div class="absolute top-3 right-3 w-2 h-2 bg-[#e6ccff] rounded-full"></div>

      <h3 class="text-lg font-semibold text-gray-600 mb-1">{title}</h3>
      <p class="text-xs text-gray-400 mb-4 leading-relaxed">{description}</p>

      <div class="h-px bg-gray-200 mb-3"></div>

      <ul class="space-y-1.5 mb-4 text-[0.82rem]">
        {points.map(point => (
          <li class="flex gap-2">
            <span class="text-[#3C8FA8] shrink-0">▸</span>
            <span>{point}</span>
          </li>
        ))}
      </ul>

      <div class="h-px bg-gray-200 mb-4"></div>

      <!-- Tags -->
      <div class="flex flex-wrap gap-1.5 mb-5">
        {tags.map(tag => (
          <span class="inline-block bg-[#3C8FA8]/10 px-2 py-0.5 text-[10px] rounded text-[#3C8FA8] font-mono">
            {tag}
          </span>
        ))}
      </div>

      <!-- Links -->
      <div class="flex gap-3 mt-auto self-end">
        {githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-[12px] border border-gray-300 px-3 py-1 rounded-sm text-gray-500 hover:border-[#3C8FA8] hover:text-[#3C8FA8] transition-colors duration-200"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            Code
          </a>
        )}
        {liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-[12px] border border-[#3C8FA8] px-3 py-1 rounded-sm text-[#3C8FA8] hover:bg-[#3C8FA8] hover:text-white transition-all duration-200"
          >
            Live →
          </a>
        )}
      </div>
    </div>
  </div>
</div>