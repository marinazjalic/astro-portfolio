---
interface Props {
  title: string;
  description: string;
  points: string[];
  tags: string[];
  githubUrl?: string;
  liveUrl?: string;
  imagePlaceholder?: string;
}

const {
  title,
  description,
  points,
  tags,
  githubUrl,
  liveUrl,
  imagePlaceholder = "#c8dde5",
} = Astro.props;
---

<div class="proj-card reveal">

  <!-- Colour swatch panel -->
  <div class="proj-swatch" style={{ backgroundColor: imagePlaceholder }}>
    <span class="proj-swatch-label">{title}</span>
    <!-- Corner dot -->
    <div class="swatch-dot"></div>
  </div>

  <!-- Content panel -->
  <div class="proj-body">

    <div class="proj-top">
      <h3 class="proj-title">{title}</h3>
      <p class="proj-desc">{description}</p>
    </div>

    <div class="proj-divider"></div>

    <ul class="proj-points">
      {points.map(point => (
        <li class="proj-point">
          <span class="point-arrow">▸</span>
          <span>{point}</span>
        </li>
      ))}
    </ul>

    <div class="proj-divider"></div>

    <div class="proj-tags">
      {tags.map(tag => (
        <span class="proj-tag">{tag}</span>
      ))}
    </div>

    <div class="proj-links">
      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="proj-link-code"
        >
          <svg width="13" height="13" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          Code
        </a>
      )}
      {liveUrl && (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="proj-link-live"
        >
          Live →
        </a>
      )}
    </div>

  </div>
</div>

<style>
  .proj-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    border: 0.5px solid #d6d2c4;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.55);
    transition: box-shadow 0.3s ease, transform 0.3s ease, border-color 0.3s ease;
  }
  @media (min-width: 640px) {
    .proj-card { flex-direction: row; }
  }
  .proj-card:hover {
    box-shadow: 0 6px 28px rgba(60, 143, 168, 0.1);
    transform: translateY(-2px);
    border-color: #b8d0d8;
  }

  /* Colour swatch */
  .proj-swatch {
    position: relative;
    width: 100%;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  @media (min-width: 640px) {
    .proj-swatch { width: 220px; height: auto; }
  }
  @media (min-width: 1024px) {
    .proj-swatch { width: 260px; }
  }

  .proj-swatch-label {
    font-family: monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .swatch-dot {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.45);
  }

  /* Content */
  .proj-body {
    flex: 1;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
  }

  .proj-top { margin-bottom: 0; }

  .proj-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #3d5166;
    margin: 0 0 6px;
    line-height: 1.3;
  }

  .proj-desc {
    font-size: 0.82rem;
    color: #9ca3af;
    line-height: 1.6;
    margin: 0;
  }

  .proj-divider {
    height: 0.5px;
    background: linear-gradient(to right, #d6d2c4, transparent);
    margin: 14px 0;
  }

  .proj-points {
    list-style: none;
    padding: 0;
    margin: 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .proj-point {
    display: flex;
    gap: 8px;
    font-size: 0.82rem;
    color: #6b7280;
    line-height: 1.5;
  }

  .point-arrow {
    color: #3C8FA8;
    flex-shrink: 0;
    font-size: 0.7rem;
    margin-top: 2px;
  }

  .proj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .proj-tag {
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 500;
    background: rgba(60, 143, 168, 0.1);
    color: #2d7a91;
    border: 0.5px solid rgba(60, 143, 168, 0.25);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .proj-links {
    display: flex;
    gap: 8px;
    margin-top: auto;
    padding-top: 14px;
    justify-content: flex-end;
  }

  .proj-link-code {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: monospace;
    font-size: 0.72rem;
    color: #6b7280;
    border: 0.5px solid #d6d2c4;
    padding: 4px 12px;
    border-radius: 3px;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .proj-link-code:hover { border-color: #3C8FA8; color: #3C8FA8; }

  .proj-link-live {
    display: inline-flex;
    align-items: center;
    font-family: monospace;
    font-size: 0.72rem;
    color: #3C8FA8;
    border: 0.5px solid #3C8FA8;
    padding: 4px 12px;
    border-radius: 3px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .proj-link-live:hover { background: #3C8FA8; color: white; }
</style>