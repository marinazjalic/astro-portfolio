---
---

<div class="hero-shapes" aria-hidden="true">
  <!-- Circles -->
  <div class="shape circle-xl"></div>
  <div class="shape circle-lg"></div>
  <div class="shape circle-md"></div>
  <div class="shape circle-sm"></div>
  <div class="shape circle-xs"></div>

  <!-- Squares -->
  <div class="shape square-lg"></div>
  <div class="shape square-md"></div>
  <div class="shape square-sm"></div>

  <!-- Dots -->
  <div class="shape dot dot-1"></div>
  <div class="shape dot dot-2"></div>
  <div class="shape dot dot-3"></div>
  <div class="shape dot dot-4"></div>
  <div class="shape dot dot-5"></div>
  <div class="shape dot dot-6"></div>

  <!-- Plus crosses -->
  <div class="plus plus-1">
    <span class="plus-h"></span><span class="plus-v"></span>
  </div>
  <div class="plus plus-2">
    <span class="plus-h"></span><span class="plus-v"></span>
  </div>
  <div class="plus plus-3">
    <span class="plus-h teal"></span><span class="plus-v teal"></span>
  </div>

  <!-- Triangle-ish: rotated square with fill -->
  <div class="shape diamond"></div>
</div>

<style>
  .hero-shapes {
    position: absolute;
    top: 0;
    right: 0;
    width: 45%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }

  /* ── Keyframes — bigger amplitude ─────────── */
  @keyframes floatA {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-22px) rotate(8deg);
    }
  }
  @keyframes floatB {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-18px) rotate(-6deg);
    }
  }
  @keyframes floatC {
    0%,
    100% {
      transform: rotate(20deg) translateY(0px);
    }
    50% {
      transform: rotate(34deg) translateY(-16px);
    }
  }
  @keyframes floatD {
    0%,
    100% {
      transform: rotate(-10deg) translateY(0px);
    }
    50% {
      transform: rotate(2deg) translateY(-14px);
    }
  }
  @keyframes floatE {
    0%,
    100% {
      transform: translateY(0px) translateX(0px);
    }
    33% {
      transform: translateY(-12px) translateX(8px);
    }
    66% {
      transform: translateY(-20px) translateX(-6px);
    }
  }
  @keyframes floatF {
    0%,
    100% {
      transform: rotate(45deg) translateY(0px);
    }
    50% {
      transform: rotate(55deg) translateY(-14px);
    }
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 0.2;
      transform: scale(1.3);
    }
  }
  @keyframes pulseSlow {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.12;
      transform: scale(1.2);
    }
  }

  .shape {
    position: absolute;
  }

  /* ── Circles ───────────────────────────────── */
  .circle-xl {
    width: clamp(100px, 16vw, 200px);
    height: clamp(100px, 16vw, 200px);
    border-radius: 50%;
    border: 1.5px solid #3c8fa8;
    opacity: 0.2;
    top: 3%;
    right: 6%;
    animation: floatA 7s ease-in-out infinite;
  }
  .circle-lg {
    width: clamp(60px, 10vw, 120px);
    height: clamp(60px, 10vw, 120px);
    border-radius: 50%;
    border: 1px solid #c17b9e;
    opacity: 0.22;
    top: 10%;
    right: 32%;
    animation: floatB 9s ease-in-out infinite;
    animation-delay: 1s;
  }
  .circle-md {
    width: clamp(44px, 7vw, 84px);
    height: clamp(44px, 7vw, 84px);
    border-radius: 50%;
    border: 1.5px solid #c17b9e;
    opacity: 0.22;
    top: 42%;
    right: 2%;
    animation: floatE 8s ease-in-out infinite;
    animation-delay: 0.8s;
  }
  .circle-sm {
    width: clamp(26px, 4vw, 46px);
    height: clamp(26px, 4vw, 46px);
    border-radius: 50%;
    border: 1.5px solid #3c8fa8;
    opacity: 0.25;
    top: 65%;
    right: 22%;
    animation: floatA 10s ease-in-out infinite;
    animation-delay: 2s;
  }
  .circle-xs {
    width: clamp(14px, 2vw, 24px);
    height: clamp(14px, 2vw, 24px);
    border-radius: 50%;
    border: 1px solid #3c8fa8;
    opacity: 0.28;
    top: 80%;
    right: 38%;
    animation: floatB 6s ease-in-out infinite;
    animation-delay: 3.5s;
  }

  /* ── Squares ───────────────────────────────── */
  .square-lg {
    width: clamp(36px, 5.5vw, 66px);
    height: clamp(36px, 5.5vw, 66px);
    border: 1.5px solid #c17b9e;
    opacity: 0.2;
    top: 18%;
    right: 14%;
    animation: floatC 11s ease-in-out infinite;
    animation-delay: 0.3s;
  }
  .square-md {
    width: clamp(22px, 3.2vw, 40px);
    height: clamp(22px, 3.2vw, 40px);
    border: 1.5px solid #3c8fa8;
    opacity: 0.22;
    top: 55%;
    right: 8%;
    animation: floatD 9s ease-in-out infinite;
    animation-delay: 2.2s;
  }
  .square-sm {
    width: clamp(12px, 2vw, 22px);
    height: clamp(12px, 2vw, 22px);
    border: 1px solid #c17b9e;
    opacity: 0.25;
    top: 76%;
    right: 5%;
    animation: floatC 7s ease-in-out infinite;
    animation-delay: 1.5s;
  }

  /* ── Diamond ───────────────────────────────── */
  .diamond {
    width: clamp(18px, 2.8vw, 34px);
    height: clamp(18px, 2.8vw, 34px);
    border: 1.5px solid #3c8fa8;
    opacity: 0.2;
    top: 35%;
    right: 28%;
    animation: floatF 8s ease-in-out infinite;
    animation-delay: 1.2s;
  }

  /* ── Dots ──────────────────────────────────── */
  .dot {
    border-radius: 50%;
  }
  .dot-1 {
    width: clamp(6px, 1vw, 10px);
    height: clamp(6px, 1vw, 10px);
    background: #3c8fa8;
    top: 8%;
    right: 18%;
    animation: pulse 3.5s ease-in-out infinite;
    animation-delay: 0s;
  }
  .dot-2 {
    width: clamp(5px, 0.8vw, 8px);
    height: clamp(5px, 0.8vw, 8px);
    background: #c17b9e;
    top: 26%;
    right: 42%;
    animation: pulse 4s ease-in-out infinite;
    animation-delay: 0.7s;
  }
  .dot-3 {
    width: clamp(7px, 1.1vw, 12px);
    height: clamp(7px, 1.1vw, 12px);
    background: #3c8fa8;
    top: 50%;
    right: 26%;
    animation: pulseSlow 5s ease-in-out infinite;
    animation-delay: 1.4s;
  }
  .dot-4 {
    width: clamp(4px, 0.6vw, 7px);
    height: clamp(4px, 0.6vw, 7px);
    background: #c17b9e;
    top: 68%;
    right: 14%;
    animation: pulse 3s ease-in-out infinite;
    animation-delay: 2.1s;
  }
  .dot-5 {
    width: clamp(8px, 1.2vw, 14px);
    height: clamp(8px, 1.2vw, 14px);
    background: #3c8fa8;
    opacity: 0.3;
    top: 88%;
    right: 30%;
    animation: pulseSlow 6s ease-in-out infinite;
    animation-delay: 0.5s;
  }
  .dot-6 {
    width: clamp(4px, 0.6vw, 7px);
    height: clamp(4px, 0.6vw, 7px);
    background: #c17b9e;
    top: 92%;
    right: 8%;
    animation: pulse 4.5s ease-in-out infinite;
    animation-delay: 1.8s;
  }

  /* ── Plus crosses ──────────────────────────── */
  .plus {
    position: absolute;
  }
  .plus-h,
  .plus-v {
    display: block;
    position: absolute;
    background: #c17b9e;
    opacity: 0.32;
    border-radius: 1px;
  }
  .plus-h.teal,
  .plus-v.teal {
    background: #3c8fa8;
    opacity: 0.3;
  }

  .plus-1 {
    top: 30%;
    right: 4%;
    animation: floatB 8s ease-in-out infinite;
    animation-delay: 0.6s;
  }
  .plus-1 .plus-h {
    width: clamp(12px, 2vw, 20px);
    height: 1.5px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }
  .plus-1 .plus-v {
    height: clamp(12px, 2vw, 20px);
    width: 1.5px;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
  }

  .plus-2 {
    top: 60%;
    right: 34%;
    animation: floatA 10s ease-in-out infinite;
    animation-delay: 2.8s;
  }
  .plus-2 .plus-h {
    width: clamp(10px, 1.6vw, 17px);
    height: 1.5px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }
  .plus-2 .plus-v {
    height: clamp(10px, 1.6vw, 17px);
    width: 1.5px;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
  }

  .plus-3 {
    top: 84%;
    right: 20%;
    animation: floatB 7s ease-in-out infinite;
    animation-delay: 1s;
  }
  .plus-3 .plus-h {
    width: clamp(8px, 1.3vw, 14px);
    height: 1.5px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }
  .plus-3 .plus-v {
    height: clamp(8px, 1.3vw, 14px);
    width: 1.5px;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
  }

  /* ── Responsive ────────────────────────────── */
  @media (max-width: 1024px) {
    .hero-shapes {
      width: 48%;
    }
    .circle-xl {
      opacity: 0.16;
    }
  }

  @media (max-width: 640px) {
    .hero-shapes {
      width: 100%;
      opacity: 0.5;
    }
    /* Scale down and reposition everything tightly to the top-right corner */
    .circle-xl {
      top: 1%;
      right: 1%;
      width: 80px;
      height: 80px;
    }
    .circle-lg {
      top: 8%;
      right: 28%;
      width: 44px;
      height: 44px;
    }
    .circle-md {
      top: 18%;
      right: 2%;
      width: 32px;
      height: 32px;
    }
    .circle-sm {
      top: 26%;
      right: 16%;
      width: 20px;
      height: 20px;
    }
    .circle-xs {
      top: 32%;
      right: 5%;
      width: 12px;
      height: 12px;
    }
    .square-lg {
      top: 5%;
      right: 40%;
      width: 28px;
      height: 28px;
    }
    .square-md {
      top: 22%;
      right: 30%;
      width: 16px;
      height: 16px;
    }
    .square-sm {
      top: 14%;
      right: 8%;
      width: 12px;
      height: 12px;
    }
    .diamond {
      top: 28%;
      right: 24%;
      width: 14px;
      height: 14px;
    }
    .dot-1 {
      top: 4%;
      right: 22%;
    }
    .dot-2 {
      top: 10%;
      right: 42%;
    }
    .dot-3 {
      top: 20%;
      right: 10%;
    }
    .dot-4 {
      top: 30%;
      right: 36%;
    }
    .dot-5 {
      top: 35%;
      right: 18%;
    }
    .dot-6 {
      top: 38%;
      right: 8%;
    }
    .plus-1 {
      top: 12%;
      right: 18%;
    }
    .plus-2 {
      top: 24%;
      right: 44%;
    }
    .plus-3 {
      top: 36%;
      right: 28%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shape,
    .plus,
    .dot {
      animation: none !important;
    }
  }
</style>
