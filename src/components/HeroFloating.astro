---
---

<div class="hero-shapes" aria-hidden="true">
  <div class="shape circle-lg"></div>
  <div class="shape circle-md"></div>
  <div class="shape circle-sm"></div>
  <div class="shape square-lg"></div>
  <div class="shape square-sm"></div>
  <div class="shape dot dot-1"></div>
  <div class="shape dot dot-2"></div>
  <div class="shape dot dot-3"></div>
  <div class="shape dot dot-4"></div>
  <div class="plus plus-1">
    <span class="plus-h"></span><span class="plus-v"></span>
  </div>
  <div class="plus plus-2">
    <span class="plus-h"></span><span class="plus-v"></span>
  </div>
</div>

<style>
  .hero-shapes {
    position: absolute;
    top: 0;
    right: 0;
    width: 40%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }

  @keyframes floatA {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-14px) rotate(5deg);
    }
  }
  @keyframes floatB {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(-4deg);
    }
  }
  @keyframes floatC {
    0%,
    100% {
      transform: rotate(20deg) translateY(0px);
    }
    50% {
      transform: rotate(28deg) translateY(-10px);
    }
  }
  @keyframes floatD {
    0%,
    100% {
      transform: rotate(-10deg) translateY(0px);
    }
    50% {
      transform: rotate(-4deg) translateY(-8px);
    }
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(1);
    }
    50% {
      opacity: 0.25;
      transform: scale(1.15);
    }
  }

  .shape {
    position: absolute;
  }

  /* Circles */
  .circle-lg {
    width: clamp(80px, 14vw, 160px);
    height: clamp(80px, 14vw, 160px);
    border-radius: 50%;
    border: 1.5px solid #3c8fa8;
    opacity: 0.18;
    top: 6%;
    right: 8%;
    animation: floatA 9s ease-in-out infinite;
  }
  .circle-md {
    width: clamp(44px, 7vw, 80px);
    height: clamp(44px, 7vw, 80px);
    border-radius: 50%;
    border: 1.5px solid #c17b9e;
    opacity: 0.2;
    top: 38%;
    right: 3%;
    animation: floatB 7s ease-in-out infinite;
    animation-delay: 1.2s;
  }
  .circle-sm {
    width: clamp(22px, 3.5vw, 38px);
    height: clamp(22px, 3.5vw, 38px);
    border-radius: 50%;
    border: 1.5px solid #3c8fa8;
    opacity: 0.22;
    top: 68%;
    right: 18%;
    animation: floatA 8s ease-in-out infinite;
    animation-delay: 2.5s;
  }

  /* Squares */
  .square-lg {
    width: clamp(32px, 5vw, 60px);
    height: clamp(32px, 5vw, 60px);
    border: 1.5px solid #c17b9e;
    opacity: 0.18;
    top: 14%;
    right: 28%;
    animation: floatC 10s ease-in-out infinite;
    animation-delay: 0.5s;
  }
  .square-sm {
    width: clamp(16px, 2.5vw, 28px);
    height: clamp(16px, 2.5vw, 28px);
    border: 1.5px solid #3c8fa8;
    opacity: 0.2;
    top: 55%;
    right: 6%;
    animation: floatD 8s ease-in-out infinite;
    animation-delay: 3s;
  }

  /* Dots */
  .dot {
    border-radius: 50%;
    animation: pulse 4s ease-in-out infinite;
  }
  .dot-1 {
    width: clamp(5px, 0.8vw, 8px);
    height: clamp(5px, 0.8vw, 8px);
    background: #3c8fa8;
    opacity: 0.45;
    top: 22%;
    right: 14%;
    animation-delay: 0s;
  }
  .dot-2 {
    width: clamp(4px, 0.6vw, 6px);
    height: clamp(4px, 0.6vw, 6px);
    background: #c17b9e;
    opacity: 0.4;
    top: 48%;
    right: 22%;
    animation-delay: 1s;
  }
  .dot-3 {
    width: clamp(6px, 0.9vw, 10px);
    height: clamp(6px, 0.9vw, 10px);
    background: #3c8fa8;
    opacity: 0.35;
    top: 78%;
    right: 10%;
    animation-delay: 2s;
  }
  .dot-4 {
    width: clamp(4px, 0.5vw, 6px);
    height: clamp(4px, 0.5vw, 6px);
    background: #c17b9e;
    opacity: 0.4;
    top: 30%;
    right: 36%;
    animation-delay: 0.6s;
  }

  /* Plus crosses */
  .plus {
    position: absolute;
  }
  .plus-h,
  .plus-v {
    display: block;
    position: absolute;
    background: #c17b9e;
    opacity: 0.3;
    border-radius: 1px;
  }
  .plus-1 {
    top: 60%;
    right: 30%;
    animation: floatB 9s ease-in-out infinite;
    animation-delay: 1.8s;
  }
  .plus-1 .plus-h {
    width: clamp(10px, 1.6vw, 18px);
    height: 1.5px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }
  .plus-1 .plus-v {
    height: clamp(10px, 1.6vw, 18px);
    width: 1.5px;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
  }

  .plus-2 {
    top: 20%;
    right: 42%;
    animation: floatA 11s ease-in-out infinite;
    animation-delay: 3.5s;
  }
  .plus-2 .plus-h {
    width: clamp(8px, 1.2vw, 14px);
    height: 1.5px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    background: #3c8fa8;
    opacity: 0.28;
  }
  .plus-2 .plus-v {
    height: clamp(8px, 1.2vw, 14px);
    width: 1.5px;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    background: #3c8fa8;
    opacity: 0.28;
  }

  /* Hide on small screens where they'd crowd the text */
  @media (max-width: 640px) {
    .hero-shapes {
      width: 100%;
      height: 100%;
      opacity: 0.5;
    }
    .circle-lg {
      top: 2%;
      right: 2%;
    }
    .circle-md {
      display: none;
    }
    .square-lg {
      top: 5%;
      right: 40%;
    }
    .square-sm {
      display: none;
    }
    .dot-2,
    .dot-4 {
      display: none;
    }
    .plus-2 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shape,
    .plus,
    .dot {
      animation: none;
    }
  }
</style>
