---
// TODO: replace with your real email address
const email = "marinazjalic@gmail.com";
const location = "Ontario 🇨🇦";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/resume-marina-zjalic.pdf", label: "Resume", external: true },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-grid">
    <!-- Brand + contact -->
    <div class="footer-col">
      <div class="flex items-center gap-3 mb-4">
        <div class="bg-[#3C8FA8] w-8 h-[1.5px]"></div>
        <p class="section-label">Contact</p>
      </div>
      <p class="footer-name">Marina Zjalic</p>
      <ul class="footer-list">
        <li>
          <a href={`mailto:${email}`} class="footer-link">{email}</a>
        </li>
        <!-- <li class="footer-muted">{location}</li> -->
      </ul>
    </div>

    <!-- Navigation -->
    <div class="footer-col">
      <div class="flex items-center gap-3 mb-4">
        <div class="bg-[#3C8FA8] w-8 h-[1.5px]"></div>
        <p class="section-label">Navigate</p>
      </div>
      <nav aria-label="Footer" class="footer-list">
        {navLinks.map(({ href, label, external }) => (
          <a
            href={href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            aria-current={currentPath === href ? "page" : undefined}
            class={`footer-link w-fit ${currentPath === href ? "is-active" : ""}`}
          >
            {label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Connect -->
    <div class="footer-col">
      <div class="flex items-center gap-3 mb-4">
        <div class="bg-[#3C8FA8] w-8 h-[1.5px]"></div>
        <p class="section-label">Connect</p>
      </div>
      <div class="flex flex-row gap-2 items-center">
        <a
          href="https://github.com/marinazjalic"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="social-icon after:hidden"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
        <a
          href="https://linkedin.com/in/marinazjalic"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="social-icon after:hidden"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>


  <div class="footer-bottom">
    <p>© {year} Marina Zjalic</p>
    <p class="footer-credit">
      3D model “<a
        href="https://skfb.ly/oLvXq"
        target="_blank"
        rel="noopener noreferrer">Flower Lotus</a
      >” by Ar3Designer, licensed under
      <a
        href="https://creativecommons.org/licenses/by/4.0/"
        target="_blank"
        rel="noopener noreferrer">CC BY 4.0</a
      >. Colors changed from the original.
    </p>
    <!-- <p class="footer-built">Built with Astro + Tailwind CSS</p> -->
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 10; /* sit above PageShapes */
    width: 100%;
    padding: 3rem 1.5rem 2rem;
    border-top: 1px solid #e5e7eb;
    background: rgba(235, 234, 232, 0.7);
    backdrop-filter: blur(6px);
    font-family: monospace;
  }
  @media (min-width: 768px) {
    .site-footer {
      padding-left: 3rem;
      padding-right: 3rem;
    }
  }
  @media (min-width: 1024px) {
    .site-footer {
      padding-left: 5rem;
      padding-right: 5rem;
    }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 3rem;
    }
  }

  .footer-name {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #6b7280;
    margin: 0 0 0.75rem;
  }

  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.8rem;
  }

  .footer-link {
    color: #6b7280;
    transition: color 0.2s ease;
  }
  .footer-link:hover,
  .footer-link.is-active {
    color: #3c8fa8;
  }
  .footer-muted {
    color: #9ca3af;
  }

  .social-icon {
    border: 1px solid #3c8fa8;
    color: #3c8fa8;
    padding: 4px;
    border-radius: 2px;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .social-icon:hover {
    background: #3c8fa8;
    color: white;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 0.5px solid #d6d2c4;
    font-size: 0.75rem;
    color: #9ca3af;
  }
  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
  .footer-built {
    color: #3c8fa8;
  }

  .footer-credit {
    margin: 0;
    max-width: 46rem;
    text-align: center;
    line-height: 1.5;
  }
  .footer-credit a {
    color: #6b7280;
    text-decoration: underline;
    text-decoration-color: #d6d2c4;
    text-underline-offset: 2px;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }
  .footer-credit a:hover {
    color: #3c8fa8;
    text-decoration-color: #3c8fa8;
  }
  @media (min-width: 768px) {
    .footer-credit {
      text-align: right;
    }
  }
</style>
