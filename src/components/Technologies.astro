---
import TechnologyCard from './TechnologyCard.astro';
import { technologies } from '../data/technologies';
---

<section class="tech-section">
  <p class="section-label mb-3">Stack</p>
  <h2 class="tech-heading">Technologies</h2>
  <p class="tech-sub">Tools and frameworks I use to bring ideas to life</p>

  <div class="tech-grid">
    {technologies.map(tech => <TechnologyCard {...tech} />)}
  </div>
</section>

<style>
  .tech-section {
    width: 100%;
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
    padding: 4rem 2rem;
    text-align: center;
  }

  .tech-heading {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.875rem;
    font-weight: 700;
    margin: 0 0 10px;
    background: linear-gradient(90deg, #3C8FA8, #C17B9E, #3C8FA8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tech-sub {
    font-size: 0.875rem;
    color: #9ca3af;
    margin: 0 0 2.5rem;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  @media (min-width: 480px)  { .tech-grid { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 640px)  { .tech-grid { grid-template-columns: repeat(5, 1fr); } }
  @media (min-width: 768px)  { .tech-grid { grid-template-columns: repeat(6, 1fr); } }
  @media (min-width: 1024px) { .tech-grid { grid-template-columns: repeat(8, 1fr); } }
</style>