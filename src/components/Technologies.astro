---
import TechnologyCard from '../components/TechnologyCard.astro'
import {technologies} from '../data/technologies'
---

<div class="max-w-6xl mx-auto px-4 py-8 text-center">
  <!-- <h2 class="text-4xl font-bold mb-2 ">Technologies</h2> -->
   <h2 class="text-4xl font-bold mb-5 bg-gradient-to-r from-[#3C8FA8] via-[#C17B9E] to-[#3C8FA8] bg-clip-text text-transparent">
  Technologies
</h2>

  <p class="mb-6 text-gray-500">
    <span class="text-[#3C8FA8] text-sm">&lt;</span>
    Tools and frameworks I use to bring ideas to life
    <span class="text-[#3C8FA8] text-sm">/ &gt;</span>
  </p>

  <div
    class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 space-y-4 tech-grid"
  >
    {technologies.map(tech => <TechnologyCard {...tech} />)}
  </div>
</div>


