---
import TechnologyCard from './TechnologyCard.astro';
import { technologies } from '../data/technologies';
---

<section class="tech-section">
  <p class="section-label mb-3">Stack</p>
  <h2 class="tech-heading">Technologies</h2>
  <p class="tech-sub">Languages, frameworks, and tools I work with regularly.</p>

  <div class="tech-grid">
    {technologies.map(tech => <TechnologyCard {...tech} />)}
  </div>
</section>

<style>
  .tech-section {
    width: 100%;
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
    padding: 4rem 2rem;
    text-align: center;
  }

  /* Matches the .exp-heading treatment on the Experience section
     (Oswald, text-3xl, bold, gray-500) */
  .tech-heading {
    font-family: 'Oswald', sans-serif;
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 700;
    color: #6b7280;
    margin: 0 0 10px;
  }

  .tech-sub {
    font-size: 0.875rem;
    color: #9ca3af;
    margin: 0 0 2.5rem;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  /* 8 technologies: 4 + 4 on tablets and phones, one row on desktop */
  @media (min-width: 480px)  { .tech-grid { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 1024px) { .tech-grid { grid-template-columns: repeat(8, 1fr); } }
</style>