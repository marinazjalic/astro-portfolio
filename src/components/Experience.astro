---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';

interface Props {
    start: Date,
    end: Date | "Present",
    role: string,
    company: string
    description: string[]
}

const { start, end, role, company, description} = Astro.props

---

<div class="max-w-5xl mx-auto px-6 py-10 default-text">
  <div class="flex flex-col md:flex-row text-sm text-white sm:pl-2 ">

    <div class="text-xs md:w-1/4 md:p-2">
      <p>{start} - {end}</p>
    </div>

    <div class="md:w-3/4">
      <h3 class="text-sm font-semibold">{role}</h3>
      <p class="text-xs pb-2">{company}</p>
      <ul class="list-disc pl-5 text-xs space-y-1">
        {description.map(point => (
          <li>{point}</li>
        ))}
      </ul>
    </div>
  </div>
</div>
