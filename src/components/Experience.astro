---
import Tag from './Tag.astro';
import { experienceId } from '../data/slug';

interface Props {
  start: string;
  end: string | "Present";
  role: string;
  company: string;
  description: string[];
  skills: string[];
  coop?: boolean;
}

const { start, end, role, company, description, skills, coop } = Astro.props;

function formatDate(dateStr: string | "Present"): string {
  if (dateStr === "Present") return "Present";
  const [year, month] = dateStr.split("-");
  const date = new Date(parseInt(year), parseInt(month) - 1);
  return date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}

const isPresent = end === "Present";
const id = experienceId({ company, role, start });
---

<div id={id} data-flash class="exp-card reveal group">

  <!-- Top bar: role + date -->
  <div class="exp-header">
    <div class="exp-header-left">
      <div class="exp-role-row">
        <span class="exp-role">{role}</span>
        {coop && <span class="coop-tag">Co-op</span>}
      </div>
      <span class="exp-company">{company}</span>
    </div>
    <div class="exp-date">
      <span class="font-mono text-[11px] text-gray-400">
        {formatDate(start)} — {isPresent ? <span class="text-[#3C8FA8]">Present</span> : formatDate(end)}
      </span>
      {isPresent && <span class="live-dot" aria-label="Current role"></span>}
    </div>
  </div>

  <!-- Divider -->
  <div class="exp-divider"></div>

  <!-- Bullet points -->
  {description.length > 0 && (
    <ul class="exp-bullets">
      {description.map(point => (
        <li class="exp-bullet">
          <span class="bullet-arrow">▸</span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
  )}

  <!-- Skills -->
  {skills.length > 0 && (
    <div class="exp-skills">
      {skills.map(skill => <Tag skill={skill} />)}
    </div>
  )}

</div>

<style>
  .exp-card {
    position: relative;
    /* Keeps the card clear of the sticky navbar when scrolled to via a link */
    scroll-margin-top: 6rem;
    background: rgba(255, 255, 255, 0.55);
    border: 0.5px solid #d6d2c4;
    border-radius: 10px;
    padding: 20px 24px;
    transition: box-shadow 0.3s ease, transform 0.3s ease, border-color 0.3s ease;
    overflow: hidden;
  }

  /* Left accent bar that appears on hover */
  .exp-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(to bottom, #3C8FA8, #C17B9E);
    border-radius: 10px 0 0 10px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .exp-card:hover::before {
    opacity: 1;
  }

  .exp-card:hover {
    box-shadow: 0 6px 28px rgba(60, 143, 168, 0.1);
    transform: translateY(-2px);
    border-color: #c8d8de;
  }

  .exp-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 0;
  }

  @media (min-width: 640px) {
    .exp-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .exp-header-left {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .exp-role-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 8px;
  }

  /* Plain text next to the job title, in the same muted gray and monospace
     as the dates, with a small dot separator */
  .coop-tag {
    font-family: monospace;
    font-size: 0.75rem;
    color: #9ca3af;
  }
  .coop-tag::before {
    content: '·';
    margin-right: 8px;
  }

  .exp-role {
    font-size: 1rem;
    font-weight: 600;
    color: #4a5f72;
    font-family: 'Inter', sans-serif;
    line-height: 1.3;
  }

  .exp-company {
    font-size: 0.8rem;
    font-family: monospace;
    color: #C17B9E;
  }

  .exp-date {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    padding-top: 2px;
  }

  .live-dot {
    display: inline-flex;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3C8FA8;
    position: relative;
  }
  .live-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #3C8FA8;
    opacity: 0.5;
    animation: ping 1.5s ease-out infinite;
  }
  @keyframes ping {
    0%   { transform: scale(1); opacity: 0.5; }
    100% { transform: scale(2.4); opacity: 0; }
  }

  .exp-divider {
    height: 0.5px;
    background: linear-gradient(to right, #d6d2c4, transparent);
    margin: 14px 0;
  }

  .exp-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }

  .exp-bullet {
    display: flex;
    gap: 8px;
    font-size: 0.875rem;
    color: #6b7a88;
    line-height: 1.55;
    font-family: 'Inter', sans-serif;
  }

  .bullet-arrow {
    color: #3C8FA8;
    flex-shrink: 0;
    margin-top: 1px;
    font-size: 0.75rem;
  }

  .exp-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>