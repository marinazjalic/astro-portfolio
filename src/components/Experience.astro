---

import Tag from '../components/Tag.astro'

interface Props {
    start: Date,
    end: Date | "Present",
    role: string,
    company: string
    description: string[]
    skills: string[]
}

const { start, end, role, company, description, skills } = Astro.props

---

<div class="relative flex">

<!-- Timeline dot -->
  <div
    class="absolute left-[-20px] top-2 z-5
           h-2.5 w-2.5 rounded-full
           bg-[#3C8FA8]"
  ></div>

  <!-- Main content -->
  <div class="ml-8 flex flex-col md:flex-row text-sm text-gray-500 w-full">

    <div class="text-[13px] md:w-1/4 font-mono pb-2 md:pb-0 mt-1.5">
      <p>{start} - {end}</p>
    </div>

    <div class="md:w-3/4">
         <h3
          class="text-xl font-semibold
                text-gray-500"
           >
           {role}
        </h3>
      <p class="text-sm text-[#C17B9E]">{company}</p>


      <ul class="list-disc pl-5 text-sm space-y-1 pb-4 pt-2">
        {description.map(point => (
          <li>{point}</li>
        ))}
      </ul>

      <div class="flex flex-wrap gap-2">
        {skills.map(skill => (
        <Tag skill={skill}/>
      ))}
      </div>
    </div>
  </div>
</div>
