---
import HeroFloating from './HeroFloating.astro';
---

<div
  class="relative flex flex-col lg:flex-row lg:min-h-[88vh] items-center px-8 md:px-16 lg:px-24 pt-8 pb-8 md:pt-0 md:pb-0 overflow-hidden"
>
  <!-- Floating shapes (top-right) -->
  <HeroFloating />

  <!-- Hero text -->
  <div class="max-w-2xl relative z-10">
    <div class="flex flex-row items-center mb-6 gap-3">
      <div class="bg-[#3C8FA8] w-16 h-[1.5px]"></div>
      <p class="section-label">Software Developer</p>
    </div>

    <h1 class="font-bold tracking-tighter leading-[0.88] mb-7 header-text">
      <span class="block text-[#5b7692] text-7xl sm:text-8xl lg:text-[9rem]"
        >Marina</span
      >
      <span
        class="block bg-gradient-to-r from-[#3C8FA8] via-[#C17B9E] to-[#3C8FA8] bg-clip-text text-transparent pb-4 text-8xl sm:text-9xl lg:text-[11rem]"
      >
        Zjalic.
      </span>
    </h1>

    <div class="flex flex-wrap items-center gap-2 mt-2">
      <span class="text-[#3C8FA8] font-mono text-sm">&lt;dev&gt;</span>
      <p class="default-text text-lg sm:text-xl lg:text-2xl text-gray-600">
        <span id="typed-text"></span><span class="cursor"></span>
      </p>
      <span
        class="text-[#3C8FA8] font-mono text-sm"
        id="closing-tag"
        style="opacity: 0"
        >&lt;/dev&gt;</span
      >
    </div>

    <div class="flex flex-wrap gap-4 mt-10">
      <a
        href="/portfolio"
        class="px-5 py-2.5 bg-[#3C8FA8] text-white text-sm font-mono rounded-sm hover:bg-[#2d7a91] transition-colors duration-200"
      >
        View my work →
      </a>
      <a
        href="/about"
        class="px-5 py-2.5 border border-[#3C8FA8] text-[#3C8FA8] text-sm font-mono rounded-sm hover:bg-[#3C8FA8]/10 transition-colors duration-200"
      >
        About me
      </a>
    </div>
  </div>
</div>

<script is:inline>
  const phrases = [
    "Building delightful digital experiences.",
    "Turning ideas into clean, working code.",
    "Full-stack developer. Problem solver.",
  ];

  let phraseIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  const el = document.getElementById("typed-text");
  const closingTag = document.getElementById("closing-tag");

  function type() {
    const current = phrases[phraseIndex];
    if (isDeleting) {
      el.textContent = current.substring(0, charIndex - 1);
      charIndex--;
    } else {
      el.textContent = current.substring(0, charIndex + 1);
      charIndex++;
    }

    if (!isDeleting && charIndex === current.length) {
      closingTag.style.opacity = "1";
      setTimeout(() => {
        isDeleting = true;
        closingTag.style.opacity = "0";
      }, 2200);
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      phraseIndex = (phraseIndex + 1) % phrases.length;
    }

    setTimeout(type, isDeleting ? 45 : 70);
  }

  setTimeout(type, 800);
</script>
