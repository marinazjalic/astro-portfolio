---
import HeroFloating from './HeroFloating.astro';
import HeroLotus from './HeroLotus.astro';
---

<div
  class="hero-wrap relative flex flex-col justify-center lg:justify-start lg:flex-row min-h-[88vh] items-start lg:items-center py-8 lg:py-0 overflow-hidden"
>
  <HeroFloating />

  <div class="max-w-2xl relative z-10">
    <!-- Eyebrow -->
    <div class="flex flex-row items-center mb-6 gap-3">
      <div class="bg-[#3C8FA8] w-16 h-[1.5px]"></div>
      <p class="section-label">Software Developer</p>
    </div>

    <!-- Name -->
    <h1 class="hero-name font-bold tracking-tighter leading-[0.88] mb-7">
      <span class="hero-first block text-[#5b7692]">Marina</span>
      <span
        class="block bg-gradient-to-r from-[#3C8FA8] via-[#C17B9E] to-[#3C8FA8] bg-clip-text text-transparent hero-last"
      >
        Zjalic
      </span>
    </h1>

    <!-- Typing sequence: <dev> → phrase → </dev> -->
    <div class="typing-wrap">
      <!-- Opening tag typed first -->
      <div class="tag-line">
        <span id="open-tag" class="dev-tag"></span
        ><span class="cursor" id="cursor-open"></span>
      </div>
      <!-- Phrase typed second, fixed height so layout never shifts -->
      <div class="typed-line">
        <span id="typed-text"></span
        ><span class="cursor" id="cursor-phrase" style="display: none"></span>
      </div>
      <!-- Closing tag typed last -->
      <div class="tag-line">
        <span id="close-tag" class="dev-tag"></span
        ><span class="cursor" id="cursor-close" style="display: none"></span>
      </div>
    </div>

    <!-- CTAs -->
    <div class="flex flex-wrap gap-4 mt-10">
      <a
        href="/portfolio"
        class="px-5 py-2.5 bg-[#3C8FA8] text-white text-sm font-mono rounded-sm hover:bg-[#2d7a91] transition-colors duration-200"
      >
        View my work →
      </a>
      <a
        href="/about"
        class="px-5 py-2.5 border border-[#3C8FA8] text-[#3C8FA8] text-sm font-mono rounded-sm hover:bg-[#3C8FA8]/10 transition-colors duration-200"
      >
        About me
      </a>
    </div>
  </div>

  <HeroLotus />
</div>

<style>
  /* Below 1024px: fluid side padding (2rem on phones growing to 6rem), so
     nothing jumps at 768px. From 1024px up it is the original px-24. */
  .hero-wrap {
    padding-left: clamp(2rem, 9.4vw, 6rem);
    padding-right: clamp(2rem, 9.4vw, 6rem);
  }
  @media (min-width: 1024px) {
    .hero-wrap {
      padding-left: 6rem;
      padding-right: 6rem;
    }
  }

  .hero-name {
    font-family: Georgia, "Times New Roman", serif;
    /* One size drives both names. "Zjalic" is set at 4/3 of "Marina" (the
       12rem : 9rem pair used on desktop), which keeps the two lines the same
       width at every screen size. Change this value to resize the whole name.
       Below 1024px it scales with the screen; from 1024px up it is fixed. */
    --first-size: clamp(3.75rem, min(21vw, 5rem + 6.25vw), 9rem);
  }
  @media (min-width: 1024px) {
    .hero-name {
      --first-size: 9rem;
    }
  }

  .hero-first {
    font-size: var(--first-size);
  }
  .hero-last {
    font-size: calc(var(--first-size) * 4 / 3);
    /* The gradient text is only painted inside the element's own box, and the
       tight line-height made that box too short for the descender on the "j".
       Extra bottom padding (scaled to the font size) gives it room; the negative
       margin cancels it out so the spacing stays exactly as it was (1rem). */
    padding-bottom: 0.3em;
    margin-bottom: calc(1rem - 0.3em);
  }

  .typing-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    margin-top: 8px;
  }

  .tag-line {
    min-height: 1.4rem;
    display: flex;
    align-items: center;
  }

  .dev-tag {
    font-family: "Inter", monospace;
    font-size: 0.8rem;
    color: #3c8fa8;
    line-height: 1.4;
  }

  .typed-line {
    font-family: Georgia, "Times New Roman", serif;
    /* Fluid: 1.5rem on phones up to 1.875rem on desktop */
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 1.875rem);
    line-height: 1.3;
    color: #4b5563;
    /* Reserves exactly as many lines as the longest phrase needs at the
       current width (measured by the script below, --typed-lines), so the
       layout never shifts while typing and there is no empty line left
       between the phrase and </dev>. Falls back to two lines without JS. */
    min-height: calc(var(--typed-lines, 2) * 1.3em);
    display: flex;
    align-items: flex-start;
    /* Indent the phrase like code nested between <dev> and </dev>; scales
       from 1rem on phones up to 2rem on wide screens */
    padding-left: clamp(1rem, 2.5vw, 2rem);
  }

  /* From 1024px up: the original tagline styling, unchanged */
  @media (min-width: 1024px) {
    .typed-line {
      font-size: 1.875rem;
      line-height: inherit;
      min-height: 2.75rem;
      align-items: center;
    }
  }

  /* Single cursor style, toggled between elements via display */
  .cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: #3c8fa8;
    margin-left: 1px;
    vertical-align: middle;
    animation: blink 1s step-end infinite;
  }
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
  /* Visitors who prefer reduced motion get a steady cursor instead of a blink */
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>

<script is:inline>
  // Types <dev> → phrase → </dev> once, then stays put.
  const PHRASE = "Full-stack developer. Problem solver.";

  const OPEN = "<dev>";
  const CLOSE = "</dev>";
  const START_DELAY = 600; // ms before typing begins
  const PAUSE_AFTER_OPEN = 300; // ms pause after <dev> finishes
  const PAUSE_AFTER_PHRASE = 400; // ms pause after the phrase finishes
  const SPEED_TYPE = 65;
  const KEEP_CURSOR = true; // true = leave a blinking cursor after </dev>

  const elOpen = document.getElementById("open-tag");
  const elPhrase = document.getElementById("typed-text");
  const elClose = document.getElementById("close-tag");
  const curOpen = document.getElementById("cursor-open");
  const curPhrase = document.getElementById("cursor-phrase");
  const curClose = document.getElementById("cursor-close");

  // Move the blinking cursor indicator to the active element
  function setCursor(active) {
    curOpen.style.display = active === "open" ? "inline-block" : "none";
    curPhrase.style.display = active === "phrase" ? "inline-block" : "none";
    curClose.style.display = active === "close" ? "inline-block" : "none";
  }

  // Generic type-then-callback helper
  function typeString(target, str, speed, cb) {
    let i = 0;
    function step() {
      if (i <= str.length) {
        target.textContent = str.substring(0, i);
        i++;
        setTimeout(step, speed);
      } else {
        cb();
      }
    }
    step();
  }

  function finish() {
    setCursor(KEEP_CURSOR ? "close" : "none");
  }

  function runOnce() {
    // 1. Type <dev>
    setCursor("open");
    typeString(elOpen, OPEN, SPEED_TYPE, () => {
      // 2. Pause, then type the phrase
      setTimeout(() => {
        setCursor("phrase");
        typeString(elPhrase, PHRASE, SPEED_TYPE, () => {
          // 3. Pause, then type </dev> and stop
          setTimeout(() => {
            setCursor("close");
            typeString(elClose, CLOSE, SPEED_TYPE, finish);
          }, PAUSE_AFTER_PHRASE);
        });
      }, PAUSE_AFTER_OPEN);
    });
  }

  // Visitors who prefer reduced motion get the finished text straight away
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    elOpen.textContent = OPEN;
    elPhrase.textContent = PHRASE;
    elClose.textContent = CLOSE;
    finish();
  } else {
    setTimeout(runOnce, START_DELAY);
  }

  // Below 1024px the phrase can wrap. Measure how many lines the longest
  // phrase needs at the current width and reserve just that much height.
  const typedLine = document.querySelector(".typed-line");

  function reserveLines() {
    const wrap = typedLine.parentElement;
    const probe = typedLine.cloneNode(false); // keeps the class and scoped styles
    probe.removeAttribute("id");
    probe.style.cssText =
      "position:absolute;visibility:hidden;pointer-events:none;left:0;top:0;min-height:0;width:" +
      wrap.clientWidth +
      "px";
    const text = document.createElement("span");
    probe.appendChild(text);
    wrap.appendChild(probe);

    const lineHeight = parseFloat(getComputedStyle(probe).lineHeight);
    if (!isFinite(lineHeight)) {
      // 1024px and up uses the original single-line height; nothing to measure
      probe.remove();
      return;
    }
    let most = 1;
    [PHRASE].forEach((phrase) => {
      text.textContent = phrase;
      most = Math.max(
        most,
        Math.round(probe.getBoundingClientRect().height / lineHeight),
      );
    });

    probe.remove();
    typedLine.style.setProperty("--typed-lines", most);
  }

  let resizeFrame;
  window.addEventListener("resize", () => {
    cancelAnimationFrame(resizeFrame);
    resizeFrame = requestAnimationFrame(reserveLines);
  });
  reserveLines();
  if (document.fonts) document.fonts.ready.then(reserveLines);
</script>
