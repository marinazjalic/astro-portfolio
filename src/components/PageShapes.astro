<div class="page-shapes" aria-hidden="true">
  <!-- ── Cluster A: left side, tech section area ── -->
  <div class="s ca-circle-lg"></div>
  <div class="s ca-circle-sm"></div>
  <div class="s ca-square"></div>
  <div class="s ca-dot-1"></div>
  <div class="s ca-dot-2"></div>
  <div class="plus ca-plus">
    <span class="ph pink"></span><span class="pv pink"></span>
  </div>

  <!-- ── Cluster B: right side, experience section area ── -->
  <div class="s cb-circle-lg"></div>
  <div class="s cb-circle-md"></div>
  <div class="s cb-diamond"></div>
  <div class="s cb-dot-1"></div>
  <div class="s cb-dot-2"></div>
  <div class="plus cb-plus">
    <span class="ph teal"></span><span class="pv teal"></span>
  </div>

  <!-- ── Cluster C: centre, near footer ── -->
  <div class="s cc-circle"></div>
  <div class="s cc-square-lg"></div>
  <div class="s cc-square-sm"></div>
  <div class="s cc-dot-1"></div>
  <div class="s cc-dot-2"></div>
  <div class="plus cc-plus">
    <span class="ph pink"></span><span class="pv pink"></span>
  </div>

  <!-- ── Cluster D: bottom of page, left + right ── -->
  <div class="s cd-circle-lg"></div>
  <div class="s cd-circle-sm"></div>
  <div class="s cd-circle-xs"></div>
  <div class="s cd-square-lg"></div>
  <div class="s cd-square-sm"></div>
  <div class="s cd-diamond"></div>
  <div class="s cd-dot-1"></div>
  <div class="s cd-dot-2"></div>
  <div class="s cd-dot-3"></div>
  <div class="s cd-dot-4"></div>
  <div class="plus cd-plus-1">
    <span class="ph teal"></span><span class="pv teal"></span>
  </div>
  <div class="plus cd-plus-2">
    <span class="ph pink"></span><span class="pv pink"></span>
  </div>
</div>

<style>
  @keyframes floatA {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-22px) rotate(8deg);
    }
  }
  @keyframes floatB {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-18px) rotate(-6deg);
    }
  }
  @keyframes floatC {
    0%,
    100% {
      transform: rotate(20deg) translateY(0px);
    }
    50% {
      transform: rotate(34deg) translateY(-16px);
    }
  }
  @keyframes floatD {
    0%,
    100% {
      transform: rotate(-10deg) translateY(0px);
    }
    50% {
      transform: rotate(2deg) translateY(-14px);
    }
  }
  @keyframes floatE {
    0%,
    100% {
      transform: translateY(0px) translateX(0px);
    }
    33% {
      transform: translateY(-12px) translateX(8px);
    }
    66% {
      transform: translateY(-20px) translateX(-6px);
    }
  }
  @keyframes floatF {
    0%,
    100% {
      transform: rotate(45deg) translateY(0px);
    }
    50% {
      transform: rotate(58deg) translateY(-14px);
    }
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(1);
    }
    50% {
      opacity: 0.18;
      transform: scale(1.3);
    }
  }

  /*
    Stretches to cover the entire page height so absolute-positioned
    children can be placed anywhere along the scroll.
  */
  .page-shapes {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .page-shapes {
      opacity: 0.6;
    }
    /* Tighten shapes to edges so they don't overlap content */
    .ca-circle-lg,
    .cb-circle-lg,
    .cc-circle,
    .cd-circle-lg {
      opacity: 0.12;
    }
    .ca-square,
    .cb-diamond,
    .cc-square-lg,
    .cd-square-lg {
      opacity: 0.12;
    }
  }

  .s {
    position: absolute;
  }
  .plus {
    position: absolute;
  }

  .ph,
  .pv {
    display: block;
    position: absolute;
    border-radius: 1px;
  }
  .ph.pink,
  .pv.pink {
    background: #c17b9e;
    opacity: 0.28;
  }
  .ph.teal,
  .pv.teal {
    background: #3c8fa8;
    opacity: 0.26;
  }

  /* ── Cluster A: left, ~30–50% of page height ── */
  .ca-circle-lg {
    width: clamp(70px, 9vw, 130px);
    height: clamp(70px, 9vw, 130px);
    border-radius: 50%;
