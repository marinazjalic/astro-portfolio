<!--
  Fixed shape clusters that appear throughout the page as the user scrolls.
  Uses position:fixed so they float over the content without affecting layout.
  Same animation keyframes and shape vocabulary as HeroFloating.
  Hidden on mobile to avoid cluttering small screens.
-->
<div class="page-shapes" aria-hidden="true">
  <!-- ── Cluster A: left side, mid-page (tech section area) ── -->
  <div class="s ca-circle-lg"></div>
  <div class="s ca-circle-sm"></div>
  <div class="s ca-square"></div>
  <div class="s ca-dot-1"></div>
  <div class="s ca-dot-2"></div>
  <div class="plus ca-plus">
    <span class="ph pink"></span><span class="pv pink"></span>
  </div>

  <!-- ── Cluster B: right side, lower-mid (experience section area) ── -->
  <div class="s cb-circle-lg"></div>
  <div class="s cb-circle-md"></div>
  <div class="s cb-diamond"></div>
  <div class="s cb-dot-1"></div>
  <div class="s cb-dot-2"></div>
  <div class="plus cb-plus">
    <span class="ph teal"></span><span class="pv teal"></span>
  </div>

  <!-- ── Cluster C: centre, near footer ── -->
  <div class="s cc-circle"></div>
  <div class="s cc-square-lg"></div>
  <div class="s cc-square-sm"></div>
  <div class="s cc-dot-1"></div>
  <div class="s cc-dot-2"></div>
  <div class="plus cc-plus">
    <span class="ph pink"></span><span class="pv pink"></span>
  </div>
</div>

<style>
  /* ── Shared keyframes (identical to HeroFloating) ── */
  @keyframes floatA {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-22px) rotate(8deg);
    }
  }
  @keyframes floatB {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-18px) rotate(-6deg);
    }
  }
  @keyframes floatC {
    0%,
    100% {
      transform: rotate(20deg) translateY(0px);
    }
    50% {
      transform: rotate(34deg) translateY(-16px);
    }
  }
  @keyframes floatD {
    0%,
    100% {
      transform: rotate(-10deg) translateY(0px);
    }
    50% {
      transform: rotate(2deg) translateY(-14px);
    }
  }
  @keyframes floatE {
    0%,
    100% {
      transform: translateY(0px) translateX(0px);
    }
    33% {
      transform: translateY(-12px) translateX(8px);
    }
    66% {
      transform: translateY(-20px) translateX(-6px);
    }
  }
  @keyframes floatF {
    0%,
    100% {
      transform: rotate(45deg) translateY(0px);
    }
    50% {
      transform: rotate(58deg) translateY(-14px);
    }
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(1);
    }
    50% {
      opacity: 0.18;
      transform: scale(1.3);
    }
  }

  /* ── Container ── */
  .page-shapes {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  /* Hide on small screens */
  @media (max-width: 768px) {
    .page-shapes {
      display: none;
    }
  }

  /* ── Base shape types ── */
  .s {
    position: absolute;
  }

  /* ── Plus helper ── */
  .plus {
    position: absolute;
  }
  .ph,
  .pv {
    display: block;
    position: absolute;
    border-radius: 1px;
  }
  .ph.pink,
  .pv.pink {
    background: #c17b9e;
    opacity: 0.28;
  }
  .ph.teal,
  .pv.teal {
    background: #3c8fa8;
    opacity: 0.26;
  }

  /* ═══════════════════════════════════════
     CLUSTER A — left side, ~33% down page
  ═══════════════════════════════════════ */
  .ca-circle-lg {
    width: clamp(70px, 9vw, 130px);
    height: clamp(70px, 9vw, 130px);
    border-radius: 50%;
    border: 1.5px solid #3c8fa8;
    opacity: 0.16;
    top: 32vh;
    left: 2vw;
    animation: floatA 9s ease-in-out infinite;
    animation-delay: 0.4s;
  }
  .ca-circle-sm {
    width: clamp(22px, 3vw, 38px);
    height: clamp(22px, 3vw, 38px);
    border-radius: 50%;
    border: 1px solid #c17b9e;
    opacity: 0.2;
    top: 44vh;
    left: 8vw;
    animation: floatB 7s ease-in-out infinite;
    animation-delay: 1.6s;
  }
  .ca-square {
    width: clamp(28px, 4vw, 52px);
    height: clamp(28px, 4vw, 52px);
    border: 1.5px solid #c17b9e;
    opacity: 0.17;
    top: 36vh;
    left: 11vw;
    animation: floatC 11s ease-in-out infinite;
    animation-delay: 0.8s;
  }
  .ca-dot-1 {
    width: clamp(5px, 0.8vw, 9px);
    height: clamp(5px, 0.8vw, 9px);
    border-radius: 50%;
    background: #3c8fa8;
    top: 30vh;
    left: 14vw;
    animation: pulse 3.8s ease-in-out infinite;
    animation-delay: 0s;
  }
  .ca-dot-2 {
    width: clamp(4px, 0.6vw, 7px);
    height: clamp(4px, 0.6vw, 7px);
    border-radius: 50%;
    background: #c17b9e;
    top: 48vh;
    left: 4vw;
    animation: pulse 4.2s ease-in-out infinite;
    animation-delay: 1.1s;
  }
  .ca-plus {
    top: 40vh;
    left: 17vw;
    animation: floatB 8.5s ease-in-out infinite;
    animation-delay: 2s;
  }
  .ca-plus .ph {
    width: clamp(12px, 1.8vw, 18px);
    height: 1.5px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }
  .ca-plus .pv {
    height: clamp(12px, 1.8vw, 18px);
    width: 1.5px;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
  }

  /* ═══════════════════════════════════════
     CLUSTER B — right side, ~58% down page
  ═══════════════════════════════════════ */
  .cb-circle-lg {
    width: clamp(80px, 11vw, 150px);
    height: clamp(80px, 11vw, 150px);
    border-radius: 50%;
    border: 1.5px solid #c17b9e;
    opacity: 0.15;
    top: 56vh;
    right: 2vw;
    animation: floatB 10s ease-in-out infinite;
    animation-delay: 0.6s;
  }
  .cb-circle-md {
    width: clamp(36px, 5vw, 64px);
    height: clamp(36px, 5vw, 64px);
    border-radius: 50%;
    border: 1px solid #3c8fa8;
    opacity: 0.2;
    top: 68vh;
    right: 10vw;
    animation: floatE 8s ease-in-out infinite;
    animation-delay: 1.4s;
  }
  .cb-diamond {
    width: clamp(20px, 3vw, 38px);
    height: clamp(20px, 3vw, 38px);
    border: 1.5px solid #3c8fa8;
    opacity: 0.18;
    top: 60vh;
    right: 15vw;
    animation: floatF 9s ease-in-out infinite;
    animation-delay: 0.9s;
  }
  .cb-dot-1 {
    width: clamp(6px, 0.9vw, 11px);
    height: clamp(6px, 0.9vw, 11px);
    border-radius: 50%;
    background: #c17b9e;
    top: 54vh;
    right: 13vw;
    animation: pulse 3.5s ease-in-out infinite;
    animation-delay: 0.3s;
  }
  .cb-dot-2 {
    width: clamp(4px, 0.6vw, 7px);
    height: clamp(4px, 0.6vw, 7px);
    border-radius: 50%;
    background: #3c8fa8;
    top: 72vh;
    right: 5vw;
    animation: pulse 5s ease-in-out infinite;
    animation-delay: 2.2s;
  }
  .cb-plus {
    top: 64vh;
    right: 19vw;
    animation: floatA 9s ease-in-out infinite;
    animation-delay: 1.7s;
  }
  .cb-plus .ph {
    width: clamp(10px, 1.6vw, 17px);
    height: 1.5px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }
  .cb-plus .pv {
    height: clamp(10px, 1.6vw, 17px);
    width: 1.5px;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
  }

  /* ═══════════════════════════════════════
     CLUSTER C — centre, ~82% down page
  ═══════════════════════════════════════ */
  .cc-circle {
    width: clamp(50px, 7vw, 100px);
    height: clamp(50px, 7vw, 100px);
    border-radius: 50%;
    border: 1px solid #3c8fa8;
    opacity: 0.15;
    top: 80vh;
    left: 46vw;
    animation: floatA 8s ease-in-out infinite;
    animation-delay: 1s;
  }
  .cc-square-lg {
    width: clamp(30px, 4.5vw, 58px);
    height: clamp(30px, 4.5vw, 58px);
    border: 1.5px solid #c17b9e;
    opacity: 0.16;
    top: 84vh;
    left: 38vw;
    animation: floatC 12s ease-in-out infinite;
    animation-delay: 0.5s;
  }
  .cc-square-sm {
    width: clamp(14px, 2vw, 24px);
    height: clamp(14px, 2vw, 24px);
    border: 1px solid #3c8fa8;
    opacity: 0.2;
    top: 88vh;
    left: 56vw;
    animation: floatD 7s ease-in-out infinite;
    animation-delay: 3s;
  }
  .cc-dot-1 {
    width: clamp(6px, 0.9vw, 10px);
    height: clamp(6px, 0.9vw, 10px);
    border-radius: 50%;
    background: #3c8fa8;
    top: 78vh;
    left: 52vw;
    animation: pulse 4s ease-in-out infinite;
    animation-delay: 0.8s;
  }
  .cc-dot-2 {
    width: clamp(4px, 0.6vw, 7px);
    height: clamp(4px, 0.6vw, 7px);
    border-radius: 50%;
    background: #c17b9e;
    top: 90vh;
    left: 44vw;
    animation: pulse 3.2s ease-in-out infinite;
    animation-delay: 1.5s;
  }
  .cc-plus {
    top: 82vh;
    left: 61vw;
    animation: floatB 10s ease-in-out infinite;
    animation-delay: 2.4s;
  }
  .cc-plus .ph {
    width: clamp(10px, 1.5vw, 16px);
    height: 1.5px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }
  .cc-plus .pv {
    height: clamp(10px, 1.5vw, 16px);
    width: 1.5px;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .s,
    .plus {
      animation: none !important;
    }
  }
</style>
