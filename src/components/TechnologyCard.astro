---
interface Props {
  name: string;
  icon: any;
}
const { name, icon: Icon } = Astro.props;
---

<div class="tech-card group">
  <!-- Corner accent dot -->
  <div class="corner-dot group-hover:corner-dot-hover"></div>

  <div class="icon-wrap">
    <Icon class="tech-icon" />
  </div>

  <span class="tech-name">{name}</span>
</div>

<style>
  .tech-card {
    position: relative;
    aspect-ratio: 1;
    border-radius: 10px;
    border: 0.5px solid #e0ddd8;
    background: rgba(255, 255, 255, 0.6);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    cursor: default;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    overflow: hidden;
  }

  /* Gradient background on hover */
  .tech-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(60, 143, 168, 0.08), rgba(193, 123, 158, 0.08));
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: 10px;
  }
  .tech-card:hover::before { opacity: 1; }

  .tech-card:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 16px rgba(60, 143, 168, 0.12);
    border-color: #b8d0d8;
  }

  /* Corner dot — teal base, shifts pink on hover */
  .corner-dot {
    position: absolute;
    top: 7px;
    right: 7px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(60, 143, 168, 0.35);
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .tech-card:hover .corner-dot {
    background: #C17B9E;
    transform: scale(1.3);
  }

  .icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: 6px;
  }

  /* Icon — use :global so it reaches the SVG Astro renders */
  .icon-wrap :global(svg) {
    width: 2.5rem;
    height: 2.5rem;
    color: #537d90;
    transition: color 0.3s ease, transform 0.3s ease;
  }
  .tech-card:hover .icon-wrap :global(svg) {
    color: #3C8FA8;
    transform: rotate(6deg);
  }

  .tech-name {
    margin-top: 10px;
    font-size: 10px;
    font-family: 'Inter', monospace;
    color: #9ca3af;
    transition: color 0.2s ease;
  }
  .tech-card:hover .tech-name { color: #4b5563; }
</style>