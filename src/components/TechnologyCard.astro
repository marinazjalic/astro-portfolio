---
interface Props  {
    name: string
    icon: any 
}

const { name, icon: Icon } = Astro.props; 
---

<div
  class="relative w-full lg:w-[90%] aspect-square bg-gray-100 rounded-lg shadow flex flex-col items-center justify-center p-4 group transition-transform duration-300 hover:scale-105"
>
  <div class="absolute top-2 right-2 w-2 h-2 bg-[#e6ccff] rounded-full group-hover:bg-[#B794F6]"></div>

  <div class="flex items-center justify-center w-full mt-10">
    <Icon class="w-20 h-20 text-[#b54c9b] group-hover:text-[#B794F6] transition-transform duration-300 group-hover:rotate-6" />
  </div>

  <span class="mt-5 text-sm font-mono text-gray-500 group-hover:text-gray-600">{name}</span>
</div>