---
interface Props {
  name: string;
  icon: any;
}
const { name, icon: Icon } = Astro.props;
---

<div class="tech-card group">
  <!-- Corner accent dot -->
  <div class="corner-dot group-hover:corner-dot-hover"></div>

  <div class="icon-wrap">
    <Icon class="tech-icon" />
  </div>

  <span class="tech-name">{name}</span>
</div>

<style>
  .tech-card {
    position: relative;
    aspect-ratio: 1;
    border-radius: 10px;
    border: 0.5px solid #d6d2c4;
    background: rgba(255, 255, 255, 0.55);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    cursor: default;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    overflow: hidden;
  }

  /* Same hover as the experience and project cards: soft lift + shadow */
  .tech-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 28px rgba(60, 143, 168, 0.1);
    border-color: #c8d8de;
  }

  /* Corner dot — mirrors the icon: muted blue base, brand blue on hover */
  .corner-dot {
    position: absolute;
    top: 7px;
    right: 7px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #537d90;
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .tech-card:hover .corner-dot {
    background: #3C8FA8;
    transform: scale(1.3);
  }

  .icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: 6px;
  }

  /* Icon — use :global so it reaches the SVG Astro renders */
  .icon-wrap :global(svg) {
    width: 2.75rem;
    height: 2.75rem;
    color: #537d90;
    transition: color 0.3s ease, transform 0.3s ease;
  }
  .tech-card:hover .icon-wrap :global(svg) {
    color: #3C8FA8;
    transform: rotate(6deg);
  }

  .tech-name {
    margin-top: 10px;
    font-size: 11px;
    font-family: 'Inter', monospace;
    color: #9ca3af;
    transition: color 0.2s ease;
  }
  .tech-card:hover .tech-name { color: #4b5563; }
</style>