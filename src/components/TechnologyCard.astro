---
interface Props {
  name: string;
  icon: any;
}
const { name, icon: Icon } = Astro.props;
---

<button
  type="button"
  class="tech-card group"
  data-tech={name}
  aria-haspopup="dialog"
  aria-label={`${name} — see where I've used it`}
>
  <!-- Corner accent dot -->
  <div class="corner-dot group-hover:corner-dot-hover"></div>

  <div class="icon-wrap">
    <Icon class="tech-icon" />
  </div>

  <span class="tech-name">{name}</span>
</button>

<style>
  .tech-card {
    /* It's a <button> now, so reset the browser defaults */
    appearance: none;
    font: inherit;
    width: 100%;
    margin: 0;
    text-align: center;
    position: relative;
    aspect-ratio: 1;
    border-radius: 10px;
    border: 0.5px solid #d6d2c4;
    background: rgba(255, 255, 255, 0.55);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    overflow: hidden;
    /* Lets the icon, dot and label scale with the card's width (cqw units) */
    container-type: inline-size;
  }

  /* Soft lift like the experience and project cards, with a pink border
     and shadow to pair with the blue icon and dot */
  .tech-card:hover,
  .tech-card:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 6px 28px rgba(193, 123, 158, 0.18);
    border-color: #C17B9E;
  }

  /* Corner dot — mirrors the icon: muted blue base, brand blue on hover */
  .corner-dot {
    position: absolute;
    top: clamp(7px, 5cqw, 12px);
    right: clamp(7px, 5cqw, 12px);
    width: clamp(6px, 4.5cqw, 9px);
    height: clamp(6px, 4.5cqw, 9px);
    border-radius: 50%;
    background: #537d90;
    transition: background 0.3s ease, transform 0.3s ease;
  }
  .tech-card:focus-visible {
    outline: 2px solid #3C8FA8;
    outline-offset: 2px;
  }
  .tech-card:active { transform: translateY(0); }

  .tech-card:hover .corner-dot,
  .tech-card:focus-visible .corner-dot {
    background: #3C8FA8;
    transform: scale(1.3);
  }

  .icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: 6px;
  }

  /* Icon — use :global so it reaches the SVG Astro renders */
  .icon-wrap :global(svg) {
    width: clamp(1.75rem, 46cqw, 5rem);
    height: clamp(1.75rem, 46cqw, 5rem);
    color: #537d90;
    transition: color 0.3s ease, transform 0.3s ease;
  }
  .tech-card:hover .icon-wrap :global(svg),
  .tech-card:focus-visible .icon-wrap :global(svg) {
    color: #3C8FA8;
    transform: rotate(6deg);
  }

  .tech-name {
    margin-top: clamp(8px, 8cqw, 14px);
    font-size: clamp(10px, 9.5cqw, 14px);
    font-family: 'Inter', monospace;
    color: #9ca3af;
    transition: color 0.2s ease;
  }
  .tech-card:hover .tech-name,
  .tech-card:focus-visible .tech-name { color: #4b5563; }
</style>