---
interface Props {
  name: string;
  icon: any;
}
const { name, icon: Icon } = Astro.props;
---

<div
  class="relative aspect-square rounded-lg shadow-sm flex flex-col items-center justify-center p-4 group transition-all duration-300 hover:scale-105 hover:shadow-md bg-white/60 border border-[#e6e6e6]"
>
  <!-- Corner accent dot -->
  <div class="absolute top-2 right-2 w-1.5 h-1.5 bg-[#e6ccff] rounded-full group-hover:bg-[#C17B9E] transition-colors duration-300"></div>

  <div class="flex items-center justify-center w-full mt-6">
    <Icon
      class="w-14 h-14 text-[#537d90] group-hover:text-[#C17B9E] transition-all duration-300 group-hover:rotate-6"
    />
  </div>

  <span class="mt-4 text-[11px] font-mono text-gray-400 group-hover:text-gray-600 transition-colors duration-200">
    {name}
  </span>
</div>