---
import "../styles/global.css";
interface Props {
  title?: string;
}
const { title = "marinazjalic.com" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <script>
      // When someone arrives via a link like /portfolio#proj-readify (e.g. from the
      // technology popup), highlight the card they were sent to.
      import { flashTarget } from "../scripts/flash-target";

      const flashFromHash = () => {
        const id = decodeURIComponent(window.location.hash.slice(1));
        if (!id) return;
        const el = document.getElementById(id);
        if (el && el.hasAttribute("data-flash")) flashTarget(el);
      };

      // Short delay so it plays once the browser has finished scrolling to the card
      window.addEventListener("load", () => setTimeout(flashFromHash, 350));
      window.addEventListener("hashchange", flashFromHash);
    </script>
  </body>
</html>
